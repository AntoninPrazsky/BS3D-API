# The score service (issue #3). Installed to /etc/systemd/system by deploy/update.sh, from the release it belongs to.
# It listens on loopback only: the internet reaches it through cloudflared (issue #2), the LAN not at all.
[Unit]
Description=BS3D score service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bs3d-api
Group=bs3d-api
WorkingDirectory=/var/lib/bs3d-api
ExecStart=/opt/bs3d-api/current/BS3D.Api
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=Scores__Database=/var/lib/bs3d-api/scores.db
Environment=Scores__CeilingsDirectory=/var/lib/bs3d-api/ceilings
# The salt and anything else secret: root-only, read by systemd before it drops to the service user. Never in this file.
EnvironmentFile=/etc/bs3d-api/env
Restart=always
RestartSec=5

# The service writes its database and nothing else
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bs3d-api

# Apart from the admin page (#5), which runs as bs3d-api too, on a kernel without Yama. In a PID namespace of its own
# (the service is its PID 1 and starts nothing) it can neither see, signal nor ptrace the page. sudo gives the page a
# pseudo-terminal that belongs to bs3d-api: with /dev/pts out of reach the service cannot open it and write to the
# owner's terminal
PrivatePIDs=yes
InaccessiblePaths=/dev/pts

[Install]
WantedBy=multi-user.target

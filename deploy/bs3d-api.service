# The score service (issue #3). Installed to /etc/systemd/system by deploy/update.sh, from the release it belongs to.
# It listens on loopback only: the internet reaches it through cloudflared (issue #2), the LAN not at all.
[Unit]
Description=BS3D score service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bs3d-api
Group=bs3d-api
WorkingDirectory=/var/lib/bs3d-api
ExecStart=/opt/bs3d-api/current/BS3D.Api
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=Scores__Database=/var/lib/bs3d-api/scores.db
Environment=Scores__CeilingsDirectory=/var/lib/bs3d-api/ceilings
# The salt and anything else secret: root-only, read by systemd before it drops to the service user. Never in this file.
EnvironmentFile=/etc/bs3d-api/env
Restart=always
RestartSec=5

# The service writes its database and nothing else
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bs3d-api

# Apart from the admin page (#5), which runs as bs3d-api too. sudo gives the page a pseudo-terminal that belongs to
# bs3d-api: with /dev/pts out of reach the service cannot open it and write to the owner's terminal. The page makes
# itself undumpable, so the service cannot ptrace it or read its memory either. PrivatePIDs=yes was here from v0.1.9 to
# v0.1.14 and is not: systemd 257 took the service for a process not its own, and stopped it with SIGKILL at once in 3
# of 6 stops, the graceful shutdown skipped. What it added, the page neither seen nor signalled, protects nothing the
# service cannot read for itself.
InaccessiblePaths=/dev/pts

[Install]
WantedBy=multi-user.target
